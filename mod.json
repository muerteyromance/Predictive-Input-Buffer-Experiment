{
  "geode": "5.11.2",
  "gd": { "win": "2.2081" },
  "id": "cesar.input-buffer",
  "name": "Predictive Input Buffer",
  "version": "v0.5.0",
  "developer": "CesarGD96",
  "description": "Input buffer with presets and a cmd console. Cycle key changes the preset, hold a key to pause.",
  "settings": {
    "title-keys": { "type": "title", "name": "Controls" },
    "cycle-key": {
      "type": "string", "name": "Preset cycle key", "default": "F7",
      "one-of": ["F7", "F8", "F9", "F10"],
      "description": "Cycles Suave > Medio > Alto > Fuerte > Off. F6 is left free for the original mod."
    },
    "hold-disable-key": {
      "type": "string", "name": "Hold-to-pause key", "default": "Shift",
      "one-of": ["Shift", "Ctrl", "Alt", "None"],
      "description": "While held, the buffer is paused and inputs are raw."
    },
    "start-preset": {
      "type": "string", "name": "Preset at game start", "default": "Suave",
      "one-of": ["Suave", "Medio", "Alto", "Fuerte", "Off"]
    },

    "title-engine": { "type": "title", "name": "Engine" },
    "tps": {
      "type": "int", "name": "Physics TPS", "default": 240, "min": 30, "max": 1000,
      "description": "Used to convert ticks to milliseconds. Set it to the TPS you play at."
    },
    "release-point": {
      "type": "string", "name": "Where delayed inputs are released", "default": "playerUpdate",
      "one-of": ["playerUpdate", "processCommands"],
      "description": "If clicks feel lost, switch this and test again. Applies live."
    },
    "release-percent": {
      "type": "int", "name": "Release delay (% of click delay)", "default": 100, "min": 0, "max": 200
    },
    "max-ms": {
      "type": "int", "name": "Maximum delay (ms)", "default": 70, "min": 1, "max": 200
    },

    "title-modes": { "type": "title", "name": "Strength per gamemode (% of the preset)" },
    "wave-percent":   { "type": "int", "name": "Wave",   "default": 100, "min": 0, "max": 200 },
    "ship-percent":   { "type": "int", "name": "Ship",   "default": 0,   "min": 0, "max": 200,
                        "description": "0 = ship stays fully raw." },
    "ufo-percent":    { "type": "int", "name": "UFO",    "default": 100, "min": 0, "max": 200 },
    "cube-percent":   { "type": "int", "name": "Cube",   "default": 100, "min": 0, "max": 200 },
    "ball-percent":   { "type": "int", "name": "Ball",   "default": 100, "min": 0, "max": 200 },
    "robot-percent":  { "type": "int", "name": "Robot",  "default": 100, "min": 0, "max": 200 },
    "spider-percent": { "type": "int", "name": "Spider", "default": 100, "min": 0, "max": 200 },
    "swing-percent":  { "type": "int", "name": "Swing",  "default": 0,   "min": 0, "max": 200 },

    "title-console": { "type": "title", "name": "Console" },
    "console-enabled": {
      "type": "bool", "name": "Open the cmd console", "default": true,
      "description": "Needs a game restart to take effect."
    },
    "debug": {
      "type": "bool", "name": "Debug (also write events to the Geode log)", "default": false
    }
  }
}
